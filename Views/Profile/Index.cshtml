@model Thinkfeed.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Profile";

    string displayName = !string.IsNullOrWhiteSpace(Model.FullName)
        ? Model.FullName
        : Model.UserName ?? "User";

    string profileInitial = !string.IsNullOrWhiteSpace(displayName)
        ? displayName.Substring(0, 1).ToUpper()
        : "U";
}

<div class="profile-container">

    <div class="profile-card">

        <div class="profile-image-container">

            @if (!string.IsNullOrEmpty(Model.ProfileImage))
            {
                <img src="@Model.ProfileImage"
                     class="profile-image"
                     alt="Profile Image" />
            }
            else
            {
                <div class="profile-placeholder">
                    @profileInitial
                </div>
            }

        </div>

        <div class="profile-info">

            <h1>@Model.FullName</h1>

            <p class="profile-username">
                @(Model.UserName ?? "")
            </p>

            @if (!string.IsNullOrEmpty(Model.Bio))
            {
                <p class="profile-bio">
                    @Model.Bio
                </p>
            }
            else
            {
                <p class="profile-bio">
                    No bio added yet.
                </p>
            }

            <a asp-controller="Profile"
               asp-action="Edit"
               class="profile-edit-button">
                Edit Profile
            </a>

        </div>

    </div>

    <div class="profile-stats">

        <div class="profile-stat">
            <strong>@ViewBag.BlogCount</strong>
            <span>Blogs</span>
        </div>

        <div class="profile-stat">
            <strong>@ViewBag.FollowerCount</strong>
            <span>Followers</span>
        </div>

        <div class="profile-stat">
            <strong>@ViewBag.FollowingCount</strong>
            <span>Following</span>
        </div>

    </div>

    <div class="profile-blogs">

        <h2>My Blogs</h2>

        @if (Model.UserBlogs != null &&
             Model.UserBlogs.Count > 0)
        {
            @foreach (var blog in Model.UserBlogs)
            {
                <div class="blog-card">

                    @if (blog.Images != null && blog.Images.Any())
                    {
                        <div class="blog-image-carousel" data-carousel-id="profile-@blog.BlogPostId">
                            <button class="carousel-button carousel-prev" aria-label="Previous image" type="button">&lt;</button>
                            <div class="blog-image-track">
                                @foreach (var image in blog.Images)
                                {
                                    <div class="carousel-slide">
                                        <img src="@image.ImagePath" class="blog-image" alt="Blog Image" />
                                    </div>
                                }
                            </div>
                            <button class="carousel-button carousel-next" aria-label="Next image" type="button">&gt;</button>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(blog.ImagePath))
                    {
                        <img src="@blog.ImagePath"
                             class="blog-image"
                             alt="Blog Image" />
                    }

                    <div class="blog-content">

                        <h2>@blog.Title</h2>

                        <p class="blog-info">
                            @(blog.Category?.Name ?? "No Category")
                            |
                            @blog.CreatedAt.ToString("dd MMM yyyy")
                        </p>

                        <p class="blog-article">
                            @blog.Article
                        </p>

                        <a asp-controller="BlogPosts"
                           asp-action="Details"
                           asp-route-id="@blog.BlogPostId"
                           class="read-button">
                            Read More
                        </a>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="no-blogs">
                <h3>No blogs yet</h3>

                <p>
                    You haven't created any blogs yet.
                </p>

                <br />

                <a asp-controller="BlogPosts"
                   asp-action="Create"
                   class="create-blog-button">
                    Create Your First Blog
                </a>
            </div>
        }

    </div>

</div>