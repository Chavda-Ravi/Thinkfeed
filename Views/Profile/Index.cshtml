@model Thinkfeed.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Profile";
}

<div class="profile-container">

    <div class="profile-card">

        <div class="profile-image-container">

            @if (!string.IsNullOrEmpty(Model.ProfileImage))
            {
                <img src="@Model.ProfileImage"
                     class="profile-image"
                     alt="Profile Image" />
            }
            else
            {
                <div class="profile-placeholder">
                    @(Model.FullName ?? "U").Substring(0, 1).ToUpper()
                </div>
            }

        </div>

        <div class="profile-info">

            <h1>@Model.FullName</h1>

            <p class="profile-username">
                @(Model.UserName ?? "")
            </p>

            @if (!string.IsNullOrEmpty(Model.Bio))
            {
                <p class="profile-bio">
                    @Model.Bio
                </p>
            }
            else
            {
                <p class="profile-bio">
                    No bio added yet.
                </p>
            }

            <a asp-controller="Profile"
               asp-action="Edit"
               class="profile-edit-button">
                Edit Profile
            </a>

        </div>

    </div>


    <div class="profile-stats">

        <div class="profile-stat">
            <strong>@ViewBag.BlogCount</strong>
            <span>Blogs</span>
        </div>

        <div class="profile-stat">
            <strong>@ViewBag.FollowerCount</strong>
            <span>Followers</span>
        </div>

        <div class="profile-stat">
            <strong>@ViewBag.FollowingCount</strong>
            <span>Following</span>
        </div>

    </div>


    <div class="profile-blogs">

        <h2>My Blogs</h2>

        @if (ViewBag.UserBlogs != null &&
             ViewBag.UserBlogs.Count > 0)
        {
            @foreach (var blog in ViewBag.UserBlogs)
            {
                <div class="blog-card">

                    @if (!string.IsNullOrEmpty(blog.ImagePath))
                    {
                        <img src="@blog.ImagePath"
                             class="blog-image"
                             alt="Blog Image" />
                    }

                    <div class="blog-content">

                        <h2>
                            @blog.Title
                        </h2>

                        <p class="blog-info">

                            @(blog.Category?.Name ?? "No Category")

                            |

                            @blog.CreatedAt.ToString("dd MMM yyyy")

                        </p>

                        <p class="blog-article">
                            @blog.Article
                        </p>

                        <a asp-controller="BlogPosts"
                           asp-action="Details"
                           asp-route-id="@blog.BlogPostId"
                           class="read-button">
                            Read More
                        </a>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="no-blogs">

                <h3>No blogs yet</h3>

                <p>
                    You haven't created any blogs yet.
                </p>

                <br />

                <a asp-controller="BlogPosts"
                   asp-action="Create"
                   class="create-blog-button">
                    Create Your First Blog
                </a>

            </div>
        }

    </div>

</div>