@model Thinkfeed.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="profile-edit-container">

    <div class="profile-edit-box">

        <h2>Edit Profile</h2>

        <p class="profile-edit-subtitle">
            Update your Thinkfeed profile
        </p>

        <form asp-controller="Profile"
              asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="validation">
            </div>

            <div class="current-profile-image">

                @if (!string.IsNullOrEmpty(Model.ProfileImage))
                {
                    <img src="@Model.ProfileImage"
                         class="profile-edit-image"
                         alt="Profile Image" />
                }
                else
                {
                    <div class="profile-edit-placeholder">
                        @Model.FullName.Substring(0, 1).ToUpper()
                    </div>
                }

            </div>

            <div class="form-group">

                <label>Full Name</label>

                <input type="text"
                       name="FullName"
                       value="@Model.FullName"
                       placeholder="Enter your full name"
                       required />

            </div>

            <div class="form-group">

                <label>Bio</label>

                <textarea name="Bio"
                          rows="5"
                          placeholder="Tell something about yourself">@Model.Bio</textarea>

            </div>

            <div class="form-group">

                <label>Profile Image</label>

                <input type="file"
                       name="Image"
                       accept="image/*" />

            </div>

            <button type="submit"
                    class="auth-button">
                Save Changes
            </button>

        </form>

        <p class="profile-back-link">

            <a asp-controller="Profile"
               asp-action="Index">
                Back to Profile
            </a>

        </p>

    </div>

</div>