@model Thinkfeed.Models.ApplicationUser

@{
    ViewData["Title"] = Model.FullName ?? Model.UserName;
}

<div class="profile-container">

    <div class="profile-card">

        <div class="profile-image-container">

            @if (!string.IsNullOrEmpty(Model.ProfileImage))
            {
                <img src="@Model.ProfileImage"
                     class="profile-image"
                     alt="Profile Image" />
            }
            else
            {
                <div class="profile-placeholder">
                    @(Model.FullName ?? Model.UserName ?? "U").Substring(0, 1).ToUpper()
                </div>
            }

        </div>

        <div class="profile-info">

            <h1>@(Model.FullName ?? "User")</h1>

            <p class="profile-username">
                @(Model.UserName ?? "")
            </p>

            @if (!string.IsNullOrEmpty(Model.Bio))
            {
                <p class="profile-bio">
                    @Model.Bio
                </p>
            }
            else
            {
                <p class="profile-bio">
                    No bio added yet.
                </p>
            }

            @if (User.Identity != null &&
                 User.Identity.IsAuthenticated &&
                 User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value != Model.Id)
            {
                <form asp-controller="Follow"
                      asp-action="Toggle"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="userId"
                           value="@Model.Id" />

                    @if (ViewBag.IsFollowing)
                    {
                        <button type="submit"
                                class="profile-edit-button">
                            Unfollow
                        </button>
                    }
                    else
                    {
                        <button type="submit"
                                class="profile-edit-button">
                            Follow
                        </button>
                    }

                </form>
            }

        </div>

    </div>

    <div class="profile-stats">

        <div class="profile-stat">
            <strong>@ViewBag.BlogCount</strong>
            <span>Blogs</span>
        </div>

        <div class="profile-stat">
            <strong>@ViewBag.FollowerCount</strong>
            <span>Followers</span>
        </div>

        <div class="profile-stat">
            <strong>@ViewBag.FollowingCount</strong>
            <span>Following</span>
        </div>

    </div>

</div>