@model Thinkfeed.Models.ApplicationUser

@{
    ViewData["Title"] = Model.FullName ?? Model.UserName;
}

<div class="profile-container">

    <div class="profile-card">

        <div class="profile-image-container">

            @if (!string.IsNullOrEmpty(Model.ProfileImage))
            {
                <img src="@Model.ProfileImage"
                     class="profile-image"
                     alt="Profile Image" />
            }
            else
            {
                <div class="profile-placeholder">
                    @(Model.FullName ?? Model.UserName ?? "U")
                    .Substring(0, 1)
                    .ToUpper()
                </div>
            }

        </div>

        <div class="profile-info">

            <h1>@(Model.FullName ?? "User")</h1>

            <p class="profile-username">
                @(Model.UserName ?? "")
            </p>

            @if (!string.IsNullOrEmpty(Model.Bio))
            {
                <p class="profile-bio">
                    @Model.Bio
                </p>
            }
            else
            {
                <p class="profile-bio">
                    No bio added yet.
                </p>
            }

            @if (User.Identity != null &&
                 User.Identity.IsAuthenticated &&
                 User.FindFirst(
                     System.Security.Claims.ClaimTypes.NameIdentifier
                 )?.Value != Model.Id)
            {
                <form asp-controller="Follow"
                      asp-action="Toggle"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="userId"
                           value="@Model.Id" />

                    @if (ViewBag.IsFollowing)
                    {
                        <button type="submit"
                                class="profile-edit-button">
                            Unfollow
                        </button>
                    }
                    else
                    {
                        <button type="submit"
                                class="profile-edit-button">
                            Follow
                        </button>
                    }

                </form>
            }

        </div>

    </div>


    <div class="profile-stats">

        <div class="profile-stat">
            <strong>@ViewBag.BlogCount</strong>
            <span>Blogs</span>
        </div>

        <div class="profile-stat">
            <strong>@ViewBag.FollowerCount</strong>
            <span>Followers</span>
        </div>

        <div class="profile-stat">
            <strong>@ViewBag.FollowingCount</strong>
            <span>Following</span>
        </div>

    </div>


    <div class="profile-blogs">

        <h2>Blogs</h2>

        @if (ViewBag.UserBlogs != null &&
             ViewBag.UserBlogs.Count > 0)
        {
            @foreach (var blog in ViewBag.UserBlogs)
            {
                <div class="blog-card">

                    @if (!string.IsNullOrEmpty(blog.ImagePath))
                    {
                        <img src="@blog.ImagePath"
                             class="blog-image"
                             alt="Blog Image" />
                    }

                    <div class="blog-content">

                        <h2>
                            @blog.Title
                        </h2>

                        <p class="blog-info">

                            @(blog.Category?.Name ?? "No Category")

                            |

                            @blog.CreatedAt.ToString("dd MMM yyyy")

                        </p>

                        <p class="blog-article">
                            @blog.Article
                        </p>

                        <a asp-controller="BlogPosts"
                           asp-action="Details"
                           asp-route-id="@blog.BlogPostId"
                           class="read-button">
                            Read More
                        </a>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="no-blogs">

                <h3>No blogs yet</h3>

                <p>
                    This user hasn't created any blogs yet.
                </p>

            </div>
        }

    </div>

</div>