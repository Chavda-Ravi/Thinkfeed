@model Thinkfeed.Models.BlogPost

@{
    ViewData["Title"] = Model.Title;
}

<div class="blog-details-container">

    <div class="blog-details-box">

        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img src="@Model.ImagePath"
                 class="blog-details-image"
                 alt="Blog Image" />
        }

        <div class="blog-details-content">

            <h1>@Model.Title</h1>

            <p class="blog-details-info">
                By

                @if (Model.User != null)
                {
                    <a asp-controller="Profile"
                       asp-action="ViewUser"
                       asp-route-id="@Model.User.Id">
                        @(Model.User.FullName ?? Model.User.UserName)
                    </a>
                }

                |
                @(Model.Category?.Name ?? "No Category")
                |
                @Model.CreatedAt.ToString("dd MMM yyyy")
            </p>

            <div class="blog-details-article">
                @Model.Article
            </div>

            <div class="blog-actions">

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <form asp-controller="Likes"
                          asp-action="Toggle"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="blogPostId"
                               value="@Model.BlogPostId" />

                        <button type="submit">
                            Like (@Model.Likes.Count)
                        </button>

                    </form>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="read-button">
                        Login to Like
                    </a>
                }

            </div>

            <hr />

            <div class="comments-section">

                <h2>Comments</h2>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <form asp-controller="Comments"
                          asp-action="Add"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="blogPostId"
                               value="@Model.BlogPostId" />

                        <textarea name="content"
                                  rows="4"
                                  placeholder="Write your comment..."
                                  required></textarea>

                        <button type="submit">
                            Add Comment
                        </button>

                    </form>
                }
                else
                {
                    <p>
                        <a asp-controller="Account"
                           asp-action="Login">
                            Login
                        </a>
                        to write a comment.
                    </p>
                }

                <div class="comment-list">

                    @if (Model.Comments.Any())
                    {
                        @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt))
                        {
                            <div class="comment-card">

                                <p class="comment-content">
                                    @comment.Content
                                </p>

                                <p class="comment-info">
                                    @comment.CreatedAt.ToString("dd MMM yyyy hh:mm tt")
                                </p>

                            </div>
                        }
                    }
                    else
                    {
                        <p>No comments yet.</p>
                    }

                </div>

            </div>

            <br />

            <a asp-controller="BlogPosts"
               asp-action="Index"
               class="back-button">
                Back to Blogs
            </a>

        </div>

    </div>

</div>