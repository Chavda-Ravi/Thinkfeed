@model Thinkfeed.Models.BlogPost

@{
    ViewData["Title"] = Model.Title;
}

<div class="blog-details-container">

    <div class="blog-details-box">

        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img src="@Model.ImagePath"
                 class="blog-details-image"
                 alt="Blog Image" />
        }

        <div class="blog-details-content">

            <h1>@Model.Title</h1>

            <p class="blog-details-info">

                By

                @if (Model.User != null)
                {
                    <a asp-controller="Profile"
                       asp-action="ViewUser"
                       asp-route-id="@Model.User.Id">
                        @(Model.User.FullName ?? Model.User.UserName)
                    </a>
                }

                |

                @(Model.Category?.Name ?? "No Category")

                |

                @Model.CreatedAt.ToString("dd MMM yyyy")

            </p>


            <div class="blog-details-article">
                @Model.Article
            </div>


            @if (User.Identity != null &&
                 User.Identity.IsAuthenticated &&
                 Model.User != null &&
                 User.FindFirst(
                     System.Security.Claims.ClaimTypes.NameIdentifier
                 )?.Value == Model.User.Id)
            {
                <div class="blog-owner-actions">

                    <a asp-controller="BlogPosts"
                       asp-action="Edit"
                       asp-route-id="@Model.BlogPostId"
                       class="profile-edit-button">
                        Edit Blog
                    </a>

                    <a asp-controller="BlogPosts"
                       asp-action="Delete"
                       asp-route-id="@Model.BlogPostId"
                       class="delete-button">
                        Delete Blog
                    </a>

                </div>
            }


            <div class="blog-actions">

                @if (User.Identity != null &&
                     User.Identity.IsAuthenticated)
                {
                    <form asp-controller="Likes"
                          asp-action="Toggle"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="blogPostId"
                               value="@Model.BlogPostId" />

                        @if (ViewBag.IsLiked == true)
                        {
                            <button type="submit">
                                ♥ Unlike (@Model.Likes.Count)
                            </button>
                        }
                        else
                        {
                            <button type="submit">
                                ♡ Like (@Model.Likes.Count)
                            </button>
                        }

                    </form>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="read-button">
                        Login to Like
                    </a>
                }

            </div>


            <hr />


            <div class="comments-section">

                <h2>Comments</h2>

                @if (User.Identity != null &&
                     User.Identity.IsAuthenticated)
                {
                    <form asp-controller="Comments"
                          asp-action="Add"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="blogPostId"
                               value="@Model.BlogPostId" />

                        <textarea name="content"
                                  rows="4"
                                  placeholder="Write your comment..."
                                  required></textarea>

                        <button type="submit">
                            Add Comment
                        </button>

                    </form>
                }
                else
                {
                    <p>

                        <a asp-controller="Account"
                           asp-action="Login">
                            Login
                        </a>

                        to write a comment.

                    </p>
                }


                <div class="comment-list">

                    @if (Model.Comments.Any())
                    {
                        @foreach (var comment in Model.Comments
                            .OrderByDescending(c => c.CreatedAt))
                        {
                            <div class="comment-card">

                                <p class="comment-author">

                                    @if (comment.User != null)
                                    {
                                        <a asp-controller="Profile"
                                           asp-action="ViewUser"
                                           asp-route-id="@comment.User.Id">

                                            @(comment.User.FullName
                                                ?? comment.User.UserName)

                                        </a>
                                    }
                                    else
                                    {
                                        <span>User</span>
                                    }

                                </p>


                                <p class="comment-content">
                                    @comment.Content
                                </p>


                                <p class="comment-info">
                                    @comment.CreatedAt.ToString(
                                        "dd MMM yyyy hh:mm tt")
                                </p>


                                @if (User.Identity != null &&
                                     User.Identity.IsAuthenticated &&
                                     comment.User != null &&
                                     User.FindFirst(
                                         System.Security.Claims.ClaimTypes.NameIdentifier
                                     )?.Value == comment.User.Id)
                                {
                                    <form asp-controller="Comments"
                                          asp-action="Delete"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@comment.CommentId" />

                                        <button type="submit"
                                                class="delete-button">
                                            Delete
                                        </button>

                                    </form>
                                }

                            </div>
                        }
                    }
                    else
                    {
                        <p>
                            No comments yet.
                        </p>
                    }

                </div>

            </div>


            <br />

            <a asp-controller="Home"
               asp-action="Index"
               class="back-button">
                Back to Thinkfeed
            </a>

        </div>

    </div>

</div>