@model IEnumerable<Thinkfeed.Models.BlogPost>

@{
    ViewData["Title"] = "Blog Posts";
}

<div class="blog-list-container">

    <div class="blog-list-header">

        <h1>Thinkfeed</h1>

        <a asp-controller="BlogPosts"
           asp-action="Create"
           class="create-blog-button">
            Create Blog
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="no-blogs">
            <h3>No blogs yet</h3>

            <p>
                Be the first person to create a blog.
            </p>
        </div>
    }
    else
    {
        @foreach (var blog in Model)
        {
            <div class="blog-card">

                @* Carousel for images *@
                <div class="blog-image-carousel" data-carousel-id="@blog.BlogPostId">
                    <button class="carousel-button carousel-prev" aria-label="Previous image" type="button">&lt;</button>
                    <div class="blog-image-track">
                        @if (blog.Images != null && blog.Images.Any())
                        {
                            @foreach (var img in blog.Images)
                            {
                                <div class="carousel-slide">
                                    <img src="@img.ImagePath" class="blog-image" alt="Blog Image" />
                                </div>
                            }
                        }
                        else if (!string.IsNullOrEmpty(blog.ImagePath))
                        {
                            <div class="carousel-slide">
                                <img src="@blog.ImagePath" class="blog-image" alt="Blog Image" />
                            </div>
                        }
                    </div>
                    <button class="carousel-button carousel-next" aria-label="Next image" type="button">&gt;</button>
                </div>

                <div class="blog-content">

                    <h2>
                        @blog.Title
                    </h2>

                    <p class="blog-info">
                        By
                        @(blog.User?.FullName ?? blog.User?.UserName)
                        |
                        @(blog.Category?.Name ?? "No Category")
                        |
                        @blog.CreatedAt.ToString("dd MMM yyyy")
                    </p>

                    <p class="blog-article">
                        @blog.Article
                    </p>

                    <a asp-controller="BlogPosts"
                       asp-action="Details"
                       asp-route-id="@blog.BlogPostId"
                       class="read-button">
                        Read More
                    </a>

                </div>

            </div>
        }
    }

</div>