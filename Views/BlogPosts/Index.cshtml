@model IEnumerable<Thinkfeed.Models.BlogPost>

@{
    ViewData["Title"] = "Blog Posts";
}

<div class="blog-list-container">

    <div class="blog-list-header">

        <h1>Thinkfeed</h1>

        <a asp-controller="BlogPosts"
           asp-action="Create"
           class="create-blog-button">
            Create Blog
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="no-blogs">
            <h3>No blogs yet</h3>

            <p>
                Be the first person to create a blog.
            </p>
        </div>
    }
    else
    {
        @foreach (var blog in Model)
        {
            <div class="blog-card">

                @if (!string.IsNullOrEmpty(blog.ImagePath))
                {
                    <img src="@blog.ImagePath"
                         class="blog-image"
                         alt="Blog Image" />
                }

                <div class="blog-content">

                    <h2>
                        @blog.Title
                    </h2>

                    <p class="blog-info">
                        By
                        @(blog.User?.FullName ?? blog.User?.UserName)
                        |
                        @(blog.Category?.Name ?? "No Category")
                        |
                        @blog.CreatedAt.ToString("dd MMM yyyy")
                    </p>

                    <p class="blog-article">
                        @blog.Article
                    </p>

                    <a asp-controller="BlogPosts"
                       asp-action="Details"
                       asp-route-id="@blog.BlogPostId"
                       class="read-button">
                        Read More
                    </a>

                </div>

            </div>
        }
    }

</div>