@model Thinkfeed.ViewModels.BlogPostViewModel

@{
    ViewData["Title"] = "Edit Blog";
}

<div class="blog-create-container">

    <div class="blog-create-box">

        <h2>Edit Blog</h2>

        <p class="blog-subtitle">
            Update your blog
        </p>

        <form asp-controller="BlogPosts"
              asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Context.Request.RouteValues["id"]" />

            <div asp-validation-summary="All"
                 class="validation">
            </div>


            <div class="form-group">

                <label>Title</label>

                <input type="text"
                       name="Title"
                       value="@Model.Title"
                       placeholder="Enter blog title"
                       required />

            </div>


            <div class="form-group">

                <label>Article</label>

                <textarea name="Article"
                          placeholder="Write your article..."
                          rows="10"
                          required>@Model.Article</textarea>

            </div>


            <div class="form-group">

                <label>Category</label>

                <select name="CategoryId"
                        required>

                    <option value="">
                        Select Category
                    </option>

                    @foreach (var category in ViewBag.Categories)
                    {
                        if (Model.CategoryId == category.CategoryId)
                        {
                            <option value="@category.CategoryId"
                                    selected>
                                @category.Name
                            </option>
                        }
                        else
                        {
                            <option value="@category.CategoryId">
                                @category.Name
                            </option>
                        }
                    }

                </select>

            </div>


            <div class="form-group">

                <label>New Blog Image</label>

                <input type="file"
                       name="Image"
                       accept="image/*" />

            </div>


            <button type="submit"
                    class="auth-button">
                Save Changes
            </button>

        </form>


        <p class="profile-back-link">

            <a asp-controller="Home"
               asp-action="Index">
                Back to Thinkfeed
            </a>

        </p>

    </div>

</div>