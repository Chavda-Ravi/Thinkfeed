@model Thinkfeed.ViewModels.BlogPostViewModel

@{
    ViewData["Title"] = "Edit Blog";
}

<div class="blog-create-container">

    <div class="blog-create-box">

        <h2>Edit Blog</h2>

        <p class="blog-subtitle">
            Update your blog
        </p>

        <form asp-controller="BlogPosts"
              asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Context.Request.RouteValues["id"]" />

            <div asp-validation-summary="All"
                 class="validation">
            </div>


            <div class="form-group">

                <label>Title</label>

                <input type="text"
                        name="Title"
                        value="@Model.Title"
                        placeholder="Enter blog title"
                        class="form-control"
                        required />

            </div>


            <div class="form-group">

                <label>Article</label>

                <textarea name="Article"
                           placeholder="Write your article..."
                           rows="10"
                           class="form-control"
                           required>@Model.Article</textarea>

            </div>


            <div class="form-group">

                <label>Category</label>

                <select name="CategoryId"
                        class="form-control"
                        required>

                    <option value="">
                        Select Category
                    </option>

                    @foreach (var category in ViewBag.Categories)
                    {
                        if (Model.CategoryId == category.CategoryId)
                        {
                            <option value="@category.CategoryId"
                                    selected>
                                @category.Name
                            </option>
                        }
                        else
                        {
                            <option value="@category.CategoryId">
                                @category.Name
                            </option>
                        }
                    }

                </select>

            </div>


            <div class="form-group">

                <label>Existing Images</label>

                <div style="margin-bottom:10px;">
                    @if (ViewBag.ExistingImages != null && ((List<string>)ViewBag.ExistingImages).Any())
                    {
                        <div class="blog-image-carousel" data-carousel-id="edit-@(Context.Request.RouteValues["id"])">
                            <button class="carousel-button carousel-prev" aria-label="Previous image" type="button">&lt;</button>
                            <div class="blog-image-track">
                                @foreach (var img in (List<string>)ViewBag.ExistingImages)
                                {
                                    <div class="carousel-slide">
                                        <img src="@img" class="blog-image" alt="Blog Image" />
                                    </div>
                                }
                            </div>
                            <button class="carousel-button carousel-next" aria-label="Next image" type="button">&gt;</button>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No images</p>
                    }
                </div>

                <label>Add More Images (optional)</label>

                <input asp-for="Images"
                        type="file"
                        class="form-control"
                        multiple
                        accept="image/*" />

                <small class="text-muted">
                    Selected images will be added to the existing images (additive). You can upload up to 10 images, each max 5 MB.
                </small>

            </div>


            <div class="blog-form-actions">
                <button type="submit" class="auth-button">Save Changes</button>
                <a asp-controller="Home" asp-action="Index" class="secondary-button">Cancel</a>
            </div>

        </form>


        <p class="profile-back-link">

            <a asp-controller="Home"
                asp-action="Index">
                Back to Thinkfeed
            </a>

        </p>

    </div>

</div>