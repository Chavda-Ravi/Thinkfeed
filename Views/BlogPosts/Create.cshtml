@model Thinkfeed.ViewModels.BlogPostViewModel

@{
    ViewData["Title"] = "Create Blog";
}

<div class="blog-create-container">

    <div class="blog-create-box">

        <h2 class="create-blog-title">Create Blog</h2>

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data" class="create-blog-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <div class="form-group create-blog-field">
                <label>Title</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="validation"></span>
            </div>

            <div class="form-group create-blog-field">
                <label>Article</label>
                <textarea asp-for="Article" class="form-control" rows="8"></textarea>
                <span asp-validation-for="Article" class="validation"></span>
            </div>

            <div class="form-group create-blog-field">
                <label>Category</label>
                <select asp-for="CategoryId" class="form-control">
                    <option value="">-- Select Category --</option>
                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.CategoryId">@category.Name</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="validation"></span>
            </div>

            <div class="form-group create-blog-image-upload">
                <label>Blog Images</label>
                <input asp-for="Images" type="file" class="form-control" multiple accept="image/*" />
                <small class="text-muted">You can select multiple images (up to 10). Preview appears below.</small>
                <div id="create-image-preview" style="margin-top:10px; display:flex; gap:8px; flex-wrap:wrap;"></div>
            </div>

            <div class="create-blog-actions" style="display:flex; gap:10px; align-items:center; margin-top:16px;">
                <button type="submit" class="auth-button">Publish Blog</button>
                <a asp-controller="Home" asp-action="Index" class="auth-link">Cancel</a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Preview selected images locally before upload
        (function(){
            var input = document.querySelector('input[name="Images"]');
            var preview = document.getElementById('create-image-preview');
            if (!input || !preview) return;
            input.addEventListener('change', function(e){
                preview.innerHTML = '';
                var files = Array.from(this.files).slice(0,10);
                files.forEach(function(file){
                    if (!file.type.startsWith('image/')) return;
                    var reader = new FileReader();
                    reader.onload = function(ev){
                        var img = document.createElement('img');
                        img.src = ev.target.result;
                        img.style.width = '80px'; img.style.height = '80px'; img.style.objectFit = 'cover'; img.style.borderRadius = '6px';
                        preview.appendChild(img);
                    };
                    reader.readAsDataURL(file);
                });
            });
        })();
    </script>
}
