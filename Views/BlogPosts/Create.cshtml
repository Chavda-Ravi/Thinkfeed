@{
    ViewData["Title"] = "Create Blog";
}

<div class="blog-create-container">

    <div class="blog-create-box">

        <h2>Create Blog</h2>

        <p class="blog-subtitle">
            Share your thoughts with Thinkfeed
        </p>

        <form asp-controller="BlogPosts"
              asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="validation"></div>

            <div class="form-group">
                <label>Title</label>

                <input type="text"
                       name="Title"
                       placeholder="Enter blog title"
                       required />
            </div>

            <div class="form-group">
                <label>Article</label>

                <textarea name="Article"
                          placeholder="Write your article..."
                          rows="10"
                          required></textarea>
            </div>

            <div class="form-group">
                <label>Category</label>

                <select name="CategoryId" required>

                    <option value="">
                        Select Category
                    </option>

                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.CategoryId">
                            @category.Name
                        </option>
                    }

                </select>
            </div>

            <div class="form-group">
                <label>Blog Image</label>

                <input type="file"
                       name="Image"
                       accept="image/*" />
            </div>

            <button type="submit" class="auth-button">
                Publish Blog
            </button>

        </form>

    </div>

</div>