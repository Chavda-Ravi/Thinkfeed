@model IEnumerable<Thinkfeed.Models.BlogPost>

@{
	ViewData["Title"] = "Saved Posts";
}

<div class="blog-list-container">
	<div class="blog-list-header">
		<h1>Saved Posts</h1>
	</div>

	@if (!Model.Any())
	{
		<div class="no-blogs">
			<h3>No saved posts yet</h3>
			<p>Bookmark a post to find it here later.</p>
		</div>
	}
	else
	{
		@foreach (var blog in Model)
		{
			<div class="blog-card">
				<div class="blog-content">
					<h2>@blog.Title</h2>
					<p class="blog-info">
						By @(blog.User?.FullName ?? blog.User?.UserName)
						|
						@(blog.Category?.Name ?? "No Category")
						|
						@blog.CreatedAt.ToString("dd MMM yyyy")
					</p>
					<p class="blog-article">@blog.Article</p>
					<a asp-controller="BlogPosts"
					   asp-action="Details"
					   asp-route-id="@blog.BlogPostId"
					   class="read-button">
						Read More
					</a>
				</div>
			</div>
		}
	}
</div>
