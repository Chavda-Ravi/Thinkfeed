@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="card shadow-sm border-0" style="max-width: 720px; margin: 0 auto;">
        <div class="card-body text-center p-5">
            <h1 class="display-6 mb-3">Something went wrong</h1>
            <p class="text-muted mb-4">
                We couldn't complete your request right now. Please try again or return to the homepage.
            </p>

            @if (Model.ShowRequestId)
            {
                <p class="text-muted small mb-4">
                    Request ID: <code>@Model.RequestId</code>
                </p>
            }

            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                Back to Home
            </a>
        </div>
    </div>
</div>
